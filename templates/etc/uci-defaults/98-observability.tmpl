{{- $config := ds "config" -}}
#!/bin/sh
set -e

# dnsmasq updates this file in place; expose only this file read-only in the jail.
exporter=/etc/init.d/prometheus-node-exporter-ucode
if ! grep -Fq 'procd_add_jail_mount /tmp/dhcp.leases' "$exporter"; then
	grep -Fq 'procd_add_jail_mount "/etc/config"' "$exporter"
	sed -i '/procd_add_jail_mount "\/etc\/config"/a\
	[ -e /tmp/dhcp.leases ] || touch /tmp/dhcp.leases\
	procd_add_jail_mount /tmp/dhcp.leases' "$exporter"
fi

# Merge logging settings without replacing board defaults or NTP configuration.
uci batch <<'EOF'
set system.@system[0].log_remote='1'
set system.@system[0].log_ip='{{ $config.observability.log_host }}'
set system.@system[0].log_port='{{ $config.observability.log_port }}'
set system.@system[0].log_proto='tcp'
set system.@system[0].log_trailer_null='0'
commit system
EOF
/etc/init.d/log restart
